# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/loot
REDIS_URL=redis://localhost:6379

# At least 32 random characters each, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
JWT_ACCESS_SECRET=
OTP_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600

# WhatsApp Cloud API. Required in production; in development, OTPs are logged instead when unset.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=send_otp
