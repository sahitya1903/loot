# Environment Configuration Template
# Copy this file to .env.local and fill in your values
#
# Environments:
#   - development: Local development (npm run dev)
#   - test: Automated testing
#   - staging: Pre-production testing
#   - production: Live environment

# =============================================================================
# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your Apps
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Development Settings
# =============================================================================

# Set to 'true' to use Firebase Emulators in development
NEXT_PUBLIC_USE_EMULATORS=false

# =============================================================================
# App Configuration
# =============================================================================

# Your application URL (no trailing slash)
# Development: http://localhost:3000
# Staging: https://staging.<your-loot-domain>
# Production: https://www.<your-loot-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Google APIs
# =============================================================================

# Google Places API Key for address autocomplete
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# =============================================================================
# Airbridge (optional — analytics & deep links; disabled when unset)
# =============================================================================

NEXT_PUBLIC_AIRBRIDGE_APP=
NEXT_PUBLIC_AIRBRIDGE_WEB_TOKEN=
