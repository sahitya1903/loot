# Environment Configuration Template
# Copy this file to .env.local and fill in your values
#
# Environments:
#   - development: Local development (npm run dev)
#   - test: Automated testing
#   - staging: Pre-production testing
#   - production: Live environment

# =============================================================================
# Loot API (apps/api)
# =============================================================================

# Base URL of the Express API (no trailing slash). Run it locally with `npm run api`.
NEXT_PUBLIC_API_URL=http://localhost:4000

# =============================================================================
# App Configuration
# =============================================================================

# Your application URL (no trailing slash)
# Development: http://localhost:3000
# Staging: https://staging.<your-loot-domain>
# Production: https://www.<your-loot-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Google APIs
# =============================================================================

# Google Places API Key for address autocomplete
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# =============================================================================
# Airbridge (optional — analytics & deep links; disabled when unset)
# =============================================================================

NEXT_PUBLIC_AIRBRIDGE_APP=
NEXT_PUBLIC_AIRBRIDGE_WEB_TOKEN=
