{
  "name": "loot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/use-env.js dev && next dev",
    "dev:prod": "node scripts/use-env.js prod && next dev",
    "dev:staging": "node scripts/use-env.js staging && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@loot/shared": "*",
    "@radix-ui/react-toast": "^1.2.24",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix --flag v10_config_lookup_from_file",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
