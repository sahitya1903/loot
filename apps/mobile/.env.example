# Copy to .env.local (gitignored) to override where the app finds the API.
#
# Leave unset in development: the app calls the machine running Metro on port 4000
# (its LAN IP from a phone, 10.0.2.2 from the Android emulator).
# Set it for release builds, tunnels, staging or production. http URLs also make
# app.config.js allow cleartext traffic; use https for anything public.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
