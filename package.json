{
  "name": "loot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "api": "npm run dev --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
