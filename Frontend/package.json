{
  "name": "momento-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cp .env.dev .env.local && next dev",
    "dev:prod": "cp .env.prod .env.local && next dev",
    "dev:staging": "cp .env.staging .env.local && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "sync-env": "node scripts/sync-vercel-env.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^5.3.3",
    "@aws-amplify/ui-react-liveness": "^2.0.13",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/dompurify": "^3.0.5",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "^1.6.1",
    "airbridge-web-sdk-loader": "^1.11.0",
    "archiver": "^7.0.1",
    "aws-amplify": "^5.3.29",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.2",
    "heic-convert": "^1.2.4",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lenis": "1.3.18-dev.0",
    "lucide-react": "^0.559.0",
    "motion": "^12.31.0",
    "next": "^16.1.4",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
