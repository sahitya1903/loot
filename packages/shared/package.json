{
  "name": "@loot/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free Loot domain code shared by apps/api, apps/web and apps/mobile: REST client, domain constants, geo and ranking helpers.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./models": "./src/models.js",
    "./api": "./src/api/index.js",
    "./geo": "./src/geo/index.js",
    "./ranking": "./src/ranking/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --flag v10_config_lookup_from_file",
      "prettier --write"
    ]
  }
}
