{
  "name": "@loot/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free Loot domain code shared by apps/api, apps/web and apps/mobile: REST client, domain constants, geo and ranking helpers.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./models": "./src/models.js",
    "./api": "./src/api/index.js",
    "./geo": "./src/geo/index.js",
    "./ranking": "./src/ranking/index.js",
    "./schemas": "./src/schemas.js",
    "./realtime": "./src/realtime.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
